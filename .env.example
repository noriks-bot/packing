# Packing app — predloga za .env (kopiraj v .env, izpolni, chmod 600).
# .env je v .gitignore in NIKOLI ne sme v git.

# Prijava v aplikacijo (celo skladisce deli en racun)
PACKING_USER=noriks
PACKING_PASS=ZAMENJAJ-ME

# Metakocka API (rotiraj kljuc v Metakocka administraciji — stari je v git zgodovini!)
METAKOCKA_COMPANY_ID=6371
METAKOCKA_SECRET=

# AI kljuci za video-localizer (opcijsko — brez njih localizer ne dela, packing pa normalno)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
